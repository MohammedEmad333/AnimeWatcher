# Copy to `.env` and fill in. NEVER commit the real .env.

# --- Database ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=anime_watcher
DB_USER=root
DB_PASS=

# --- JWT ---
# Generate a long random secret, e.g.:  openssl rand -hex 32
JWT_SECRET=change-me-to-a-64-char-random-hex-string
JWT_ISSUER=animewatcher.api
# Access-token lifetime in seconds (default 7 days).
JWT_TTL=604800

# --- CORS ---
# Comma-separated allowlist of origins. Use * only for local development.
CORS_ALLOWED_ORIGINS=*

# --- Catalog (Jikan / MyAnimeList proxy) ---
# Upstream base URL for the anime catalog. Override only to pin a mirror.
JIKAN_BASE_URL=https://api.jikan.moe/v4
# Where cached upstream responses are written (must be writable by PHP).
CACHE_DIR=
# How long (seconds) cached catalog responses stay fresh. Default 6h.
CACHE_TTL=21600
